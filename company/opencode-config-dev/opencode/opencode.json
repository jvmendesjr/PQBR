{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9router (PQBR)",
      "options": {
        "baseURL": "http://172.31.250.1:20130/v1",
        "apiKey": "{env:NINEROUTER_API_KEY}"
      },
      "models": {
        "core-alto": {},
        "core-medio": {},
        "core-baixo": {},
        "ag/gemini-3.8-flash-medium": {},
        "ag/gpt-oss-120b-medium": {},
        "ag/claude-sonnet-4-6": {}
      }
    }
  },
  "small_model": "9router/core-baixo",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny",
      "set": "deny",
      "export": "deny",
      "declare*": "deny",
      "cat /proc/*": "deny",
      "*/proc/*/environ*": "deny",
      "*.paperclip*": "deny",
      "*dev-secrets*": "deny",
      "*context.json*": "deny",
      "find /*": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  },
  "share": "disabled",
  "autoupdate": false,
  "mcp": {
    "pqbr-kit": {
      "type": "local",
      "command": [
        "/home/pc/Workspace/PQBR/.venv/bin/python",
        "-m",
        "pqbr.kit.mcp_kit"
      ],
      "environment": {
        "PYTHONPATH": "/home/pc/Workspace/PQBR/src",
        "PQBR_KIT_PAPEL": "{env:PQBR_KIT_PAPEL}",
        "PAPERCLIP_API_KEY": "{env:PAPERCLIP_API_KEY}",
        "PAPERCLIP_RUN_ID": "{env:PAPERCLIP_RUN_ID}",
        "PQBR_PAPERCLIP_API": "http://172.31.250.1:3100",
        "TEMPORAL_ADDRESS": "172.31.250.1:7233"
      },
      "enabled": true,
      "timeout": 900000
    }
  },
  "agent": {
    "build": {
      "steps": 25
    }
  }
}