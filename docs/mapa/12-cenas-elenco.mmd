%% t150u: protagonistas definidos pelo José (nº 1 masculino, nº 2 feminina; bob-oculos = nº 13); catálogo aberto (indice 3.0.0) com categoria situações; cenas individuais citam o catálogo em refs.
%% Contrato: src/pqbr/contratos/cena.py (CenaIndividual 1.0.0). Storyboard removido 29/10/2026; sem board, sem activity de board. Fichas: config/estilo_visual.json e banco-fichas/ (pipeline/banco_fichas.py).
flowchart TD
  COD(["código PQBR-EPxxxx"]) --> ALT{"elenco_alternado<br/>par → masculino (nº 1 PERS-menino-azul) · ímpar → feminino (nº 2 PERS-menina-rosa)<br/>protagonistas definidos pelo José (t150u)"}
  ALT -->|ou elenco_excecao com motivo| VIS["cartoon 2D flat colorido, stickman (t148u/t150u)<br/>catálogo aberto banco-fichas/ (indice 3.0.0): 13 personagens<br/>figuras · animais · objetos · ambientes · situações<br/>o agente insere ficha nova: aguardando_ok_jose ou sugestão; o José aprova<br/>fichas nanquim de t146u descartadas"]
  VIS --> SB["Cenas individuais (sem board)<br/>roteiro do NotebookLM · uma cena por vez · movimento definido no prompt<br/>refs do catálogo (personagem, figura, animal, objeto, ambiente, situação)<br/>cada cena validada sozinha · não gera vídeo"]
  SB --> FC["CenaIndividual NN (rótulo ep_cNN)<br/>fala em off (fora do prompt) · norte · início · fim · movimento · plano<br/>prompt_imagem = frame de início + frase-trava<br/>prompt_animacao = corpo até o fim · lips closed<br/>refs = fichas do catálogo; recorte da folha do boneco, não a folha inteira"]
  FC --> PAP{"papel_personagem"}
  PAP -->|participa| EPO["figurino = epoca_local<br/>caracterização da época/local obrigatória"]
  PAP -->|observa| ATU["figurino = atual_variavel<br/>visual cotidiano travado da ficha (t133u)<br/>escondido, terceira pessoa, outros atuam"]
  FC --> EXP["expressao: caras e bocas ligadas à situação<br/>reação sim · articular fala NÃO"]
  FC --> ENC["cenario_encaixe: onde e como está no cenário"]
  FC --> PROI{{"reprova: framing descritivo (corta cabeça/óculos) · fala/aspas no prompt<br/>sem lips closed · participa sem figurino de época"}}
  EPO & ATU & EXP & ENC --> IMG["imagens por cena"] --> REV{"imagens_revisadas?"}
  REV -- não --> FC
  REV -- sim --> VID["vídeo por cena (07-cadeia-video)"]
  %% t108u: juiz Gemini por etapa (config/motores.json → gemini_juiz, contrato juiz_gemini 1.0.0)
  JPRE[["juiz pré-produção: 3.8 Flash<br/>roteiro · fichas · imagens de referência"]] -.-> FC
  JPRE -.-> REV
  VID --> VIS{{"gate VISUAL + LOOP · juiz produção: 4 Argon (raciocínio Baixo)<br/>reprova sozinho: boca_articula_fala · corte_oculos_cabeca · grotesco<br/>2 rodadas concordando; divergiu → terceira_rodada"}}
  %% t79u: protagonista único + coadjuvante opcional
  SB --> PROT["protagonista = nº 1 (masculino) ou nº 2 (feminina), constante no episódio"]
  FC --> CO{"coadjuvante? (o outro gênero ou qualquer PERS-* do catálogo)"}
  CO -->|sim, com justificativa no roteiro| CJ["contracena; mesmas proibições"]
  CO -->|mesmo do protagonista| PROI
