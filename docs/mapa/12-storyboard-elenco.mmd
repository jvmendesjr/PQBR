%% Contrato: src/pqbr/contratos/storyboard.py (FichaCena/Storyboard 1.2.0). Activity: storyboard_criar (t130u). Fichas: config/estilo_visual.json e banco-fichas/.
flowchart TD
  COD(["código PQBR-EPxxxx"]) --> ALT{"elenco_alternado<br/>par → PERS-M · ímpar → PERS-F"}
  ALT -->|ou elenco_excecao com motivo| VIS["stickman (t141u)<br/>cabeça branca · palito · roupa chapada<br/>cor da roupa ainda não escolhida<br/>PNG sem roupa recusado (t140u)<br/>folha nova só depois da cor"]
  VIS --> SB["Storyboard<br/>norte_geral · bloco_estilo · ficha_personagem · elenco<br/>NotebookLM devolve o JSON · não gera vídeo"]
  SB --> FC["FichaCena NN (rótulo ep_cNN)<br/>fala em off (fora do prompt) · norte · início · fim · movimento · plano<br/>prompt_imagem = frame de início + frase-trava<br/>prompt_animacao = corpo até o fim · lips closed<br/>ref = recorte de um boneco, não a folha inteira"]
  FC --> PAP{"papel_personagem"}
  PAP -->|participa| EPO["figurino = epoca_local<br/>caracterização da época/local obrigatória"]
  PAP -->|observa| ATU["figurino = atual_variavel<br/>visual cotidiano travado da ficha (t133u)<br/>escondido, terceira pessoa, outros atuam"]
  FC --> EXP["expressao: caras e bocas ligadas à situação<br/>reação sim · articular fala NÃO"]
  FC --> ENC["cenario_encaixe: onde e como está no cenário"]
  FC --> PROI{{"reprova: framing descritivo (corta cabeça/óculos) · fala/aspas no prompt<br/>sem lips closed · participa sem figurino de época"}}
  EPO & ATU & EXP & ENC --> IMG["imagens por cena"] --> REV{"imagens_revisadas?"}
  REV -- não --> FC
  REV -- sim --> VID["vídeo por cena (07-cadeia-video)"]
  %% t108u: juiz Gemini por etapa (config/motores.json → gemini_juiz, contrato juiz_gemini 1.0.0)
  JPRE[["juiz pré-produção: 3.8 Flash<br/>roteiro · storyboard/fichas · imagens de referência"]] -.-> FC
  JPRE -.-> REV
  VID --> VIS{{"gate VISUAL + LOOP · juiz produção: 4 Argon (raciocínio Baixo)<br/>reprova sozinho: boca_articula_fala · corte_oculos_cabeca · grotesco<br/>2 rodadas concordando; divergiu → terceira_rodada"}}
  %% t79u: protagonista único + coadjuvante opcional
  SB --> PROT["protagonista = elenco do episódio (constante)"]
  FC --> CO{"coadjuvante? (outro membro do elenco)"}
  CO -->|sim, com justificativa no roteiro| CJ["contracena; mesmas proibições"]
  CO -->|mesmo do protagonista| PROI
