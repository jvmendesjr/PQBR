%% Storyboard em série, personagem e elenco (t75u–t78u, 26/10/2026). Regra central do José: CONTRATO-EDITORIAL §18, REGRAS §25.
%% Contrato: src/pqbr/contratos/storyboard.py (FichaCena/Storyboard 1.1.0). Fichas do elenco: config/estilo_visual.json → elenco.
flowchart TD
  COD(["código PQBR-EPxxxx"]) --> ALT{"elenco_alternado<br/>par → masculino · ímpar → feminino"}
  ALT -->|ou elenco_excecao com motivo| SB["Storyboard<br/>norte_geral · bloco_estilo · ficha_personagem · elenco"]
  SB --> FC["FichaCena NN (rótulo ep_cNN)<br/>fala em off (fora do prompt) · norte · início · fim · movimento · plano<br/>prompt_imagem · prompt_animacao com lips closed · refs ASSET_*"]
  FC --> PAP{"papel_personagem"}
  PAP -->|participa| EPO["figurino = epoca_local<br/>caracterização da época/local obrigatória"]
  PAP -->|observa| ATU["figurino = atual_variavel<br/>roupa atual, varia entre vídeos<br/>escondido, terceira pessoa, outros atuam"]
  FC --> EXP["expressao: caras e bocas ligadas à situação<br/>reação sim · articular fala NÃO"]
  FC --> ENC["cenario_encaixe: onde e como está no cenário"]
  FC --> PROI{{"reprova: framing descritivo (corta cabeça/óculos) · fala/aspas no prompt<br/>sem lips closed · participa sem figurino de época"}}
  EPO & ATU & EXP & ENC --> IMG["imagens por cena"] --> REV{"imagens_revisadas?"}
  REV -- não --> FC
  REV -- sim --> VID["vídeo por cena (07-cadeia-video)"]
  VID --> VIS["⚠ VISUAL do gate: personagem_mexe_labios · corte_oculos_cabeca · grotesco (proposto)"]
