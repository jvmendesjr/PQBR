# Exemplo ADR-012 (t526). Copiar para ~/.camofox-instancias/<conta>.env (chmod 600). NUNCA commitar o real.
CAMOFOX_PORT=9397
PORT=9397
CAMOFOX_BIND_HOST=127.0.0.1
NODE_ENV=production
CAMOFOX_API_KEY=<gerar no criar_instancia.sh>
CAMOFOX_ACCESS_KEY=<gerar>
CAMOFOX_ADMIN_KEY=<gerar>
CAMOFOX_PROFILE_DIR=/home/pc/.camofox-instancias/<conta>/profiles
CAMOFOX_COOKIES_DIR=/home/pc/.camofox-instancias/<conta>/cookies
CAMOFOX_UPLOADS_DIR=/home/pc/.camofox-instancias/<conta>/uploads
CAMOFOX_TRACES_DIR=/home/pc/.camofox-instancias/<conta>/traces
MAX_SESSIONS=1
MAX_CONCURRENT_PER_USER=1
ENABLE_VNC=0
CAMOFOX_CRASH_REPORT_ENABLED=0
PROMETHEUS_ENABLED=0
# binário único (instalação compartilhada; versão travada em config/camofox_instancias.json)
CAMOUFOX_EXECUTABLE_PATH=/home/pc/.cache/camoufox/camoufox-bin
CAMOFOX_EXECUTABLE_PATH=/home/pc/.cache/camoufox/camoufox-bin
